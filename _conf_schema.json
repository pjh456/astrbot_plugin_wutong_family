{
  "base_url": {
    "type": "string",
    "description": "wutong-family 后端地址",
    "default": "http://127.0.0.1:8000"
  },
  "mode": {
    "type": "string",
    "description": "调用方式：session(对话) 或 data(单次)",
    "default": "session",
    "options": ["session", "data"]
  },
  "api_token": {
    "type": "string",
    "description": "可选的 API Token",
    "default": ""
  },
  "timeout": {
    "type": "int",
    "description": "请求超时（秒）",
    "default": 30
  },
  "preview_rows": {
    "type": "int",
    "description": "返回结果预览行数",
    "default": 3
  },
  "send_report_file": {
    "type": "bool",
    "description": "是否尝试直接发送 PDF 文件（否则只发送下载链接）",
    "default": false
  },
  "napcat_http_url": {
    "type": "string",
    "description": "NapCat OneBot HTTP API 地址（用于发送文件），例如 http://napcat:3000",
    "default": ""
  },
  "napcat_token": {
    "type": "string",
    "description": "NapCat OneBot HTTP API Token（可选）",
    "default": ""
  },
  "render_markdown_as_image": {
    "type": "bool",
    "description": "是否将回复 Markdown 渲染为图片",
    "default": false
  },
  "markdown_render_width": {
    "type": "int",
    "description": "Markdown 渲染图片宽度（像素）",
    "default": 960
  },
  "markdown_render_scale": {
    "type": "float",
    "description": "Markdown 渲染图片缩放（1.0-3.0）",
    "default": 2.0
  },
  "markdown_render_css": {
    "type": "string",
    "description": "Markdown 渲染附加 CSS（可选）",
    "default": ""
  }
}
